{
  "name": "rupeesplit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RupeeSplit \u2014 explainable group expense ledger and settlement planner",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-port 9229",
    "dev:realtime": "wrangler dev --local -c freebuff-realtime/wrangler.jsonc --inspector-port 9230",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=worker-dist/index.js",
    "build": "npm run typecheck && vite build && npm run build:worker",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:local": "wrangler d1 migrations apply rupeetrail-db --local",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "smoke": "node scripts/api-smoke.mjs",
    "smoke:auth": "node scripts/auth-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "wrangler": "4.148.0"
  }
}
