# Copy to .env.local and fill in after creating the Supabase project.
# The anon key is public by design; access is controlled by the RLS policies in
# supabase/migrations/0001_init.sql. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Android release manifest (server side only) -------------------------
# GET /api/app/releases reads this. Keep it out of the APK build.
# ANDROID_RELEASE_JSON={"versionCode":1,"versionName":"1.0.0","apkUrl":"https://…/rupeetrail-1.0.0.apk","sha256":"…","sizeBytes":22369929,"notes":"What changed","minSupportedCode":1}
# Individual variables are also supported: ANDROID_VERSION_CODE,
# ANDROID_VERSION_NAME, ANDROID_APK_URL, ANDROID_APK_SHA256, ANDROID_APK_SIZE,
# ANDROID_MIN_CODE, ANDROID_RELEASE_NOTES.

# --- Native app build (compiled into the APK) ----------------------------
# EXPO_PUBLIC_API_BASE=https://rupeetrail-api.onrender.com
# EXPO_PUBLIC_VERSION_CODE=1
# EXPO_PUBLIC_VERSION_NAME=1.0.0
